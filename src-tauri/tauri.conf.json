{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cabbage",
  "version": "1.0.0",
  "identifier": "com.birdturtle.cabbage",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Cabbage",
        "width": 1180,
        "height": 800,
        "minWidth": 820,
        "minHeight": 640,
        "backgroundColor": "#191919"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'"
    },
    "enableGTKAppId": true
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "targets": [
      "appimage"
    ]
  }
}
